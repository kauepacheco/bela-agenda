{
  "name": "santa-agenda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "node --import tsx prisma/seed.ts",
    "ops:maintenance": "node --import tsx scripts/maintenance.ts",
    "test:e2e": "npm run build && playwright test",
    "ops:backup": "node scripts/backup.mjs",
    "ops:restore-check": "node scripts/restore-check.mjs",
    "ops:test-backup": "node --import tsx scripts/test-backup.ts",
    "ops:check": "node --import tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "date-fns": "4.1.0",
    "lucide-react": "0.468.0",
    "next": "^16.3.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.3.5",
    "prisma": "^6.12.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
