generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  EMPLOYEE
}

model Business {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  phone                 String?
  address               String?
  city                  String                 @default("Itajaí")
  timezone              String                 @default("America/Sao_Paulo")
  onboardingCompletedAt DateTime?
  bookingSettings       Json?
  createdAt             DateTime               @default(now())
  professionals         Professional[]
  services              Service[]
  clients               Client[]
  appointments          Appointment[]
  memberships           Membership[]
  invitations           MembershipInvitation[]
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  memberships         Membership[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Membership {
  id              String                 @id @default(cuid())
  userId          String
  businessId      String
  role            MembershipRole         @default(EMPLOYEE)
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions        Session[]
  invitationsSent MembershipInvitation[] @relation("InvitationSender")

  @@unique([userId, businessId])
  @@index([businessId])
}

model MembershipInvitation {
  id                    String         @id @default(cuid())
  businessId            String
  invitedByMembershipId String?
  email                 String
  role                  MembershipRole @default(EMPLOYEE)
  tokenHash             String         @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime       @default(now())
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy             Membership?    @relation("InvitationSender", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId, email])
  @@index([expiresAt])
}

model Session {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  membershipId String
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([expiresAt])
}

model Professional {
  id           String                @id @default(cuid())
  businessId   String
  name         String
  role         String
  color        String                @default("#D97757")
  active       Boolean               @default(true)
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     ProfessionalService[]
  appointments Appointment[]

  @@index([businessId])
}

model Service {
  id            String                @id @default(cuid())
  businessId    String
  name          String
  durationMin   Int
  priceCents    Int
  active        Boolean               @default(true)
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([businessId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

model Client {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  phone        String
  notes        String?
  createdAt    DateTime      @default(now())
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, phone])
  @@index([businessId, name])
}

model Appointment {
  id             String       @id @default(cuid())
  businessId     String
  clientId       String
  professionalId String
  serviceId      String
  startsAt       DateTime
  endsAt         DateTime
  status         String       @default("CONFIRMED")
  source         String       @default("DASHBOARD")
  notes          String?
  createdAt      DateTime     @default(now())
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id])
  professional   Professional @relation(fields: [professionalId], references: [id])
  service        Service      @relation(fields: [serviceId], references: [id])
  history        AppointmentEvent[]

  @@index([businessId, startsAt])
  @@index([professionalId, startsAt, endsAt])
}

model AppointmentEvent {
  id            String      @id @default(cuid())
  appointmentId String
  actorId       String?
  action        String
  details       Json
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}
